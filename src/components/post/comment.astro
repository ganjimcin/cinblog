---
import type { CollectionEntry } from "astro:content";

import { postConfig } from "@/config";


interface Props {
    post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

let commentService = "";
---

{postConfig.comment?.enable && post.data.comment && (
    <div class="card-base p-6 mb-4 transition-swup-fade">
        {commentService === '' && null}
    </div>
)}